{
  "name": "erik-website",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:site": "next dev",
    "dev:admin": "astro dev --root admin --ignore-lock",
    "build": "biome ci . && next build && node scripts/build-sitemap.mjs",
    "preview": "wrangler dev",
    "admin": "pnpm dev:admin",
    "analyze": "ANALYZE=true pnpm build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test"
  },
  "dependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "@keystatic/core": "0.6.10",
    "@markdoc/markdoc": "^0.5.13",
    "@react-icons/all-files": "https://github.com/react-icons/react-icons/releases/download/v4.8.0/react-icons-all-files-4.8.0.tgz",
    "autoprefixer": "^10.4.14",
    "framer-motion": "10.12.4",
    "next": "13.3.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^8.3.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.7.1",
    "react-is": "^18.2.0",
    "react-tsparticles": "2.9.3",
    "react-typed": "^1.2.0",
    "sass": "1.62.1",
    "sharp": "^0.35.5",
    "tsparticles-slim": "2.9.3"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.9",
    "@biomejs/biome": "2.6.8",
    "@keystatic/astro": "6.0.0",
    "@next/bundle-analyzer": "13.3.1",
    "astro": "^7.4.12",
    "postcss": "^8.5.33",
    "postcss-flexbugs-fixes": "^5.0.2",
    "wrangler": "^4.165.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "next>postcss": "^8.5.33"
    }
  }
}
